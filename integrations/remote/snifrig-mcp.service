[Unit]
Description=snifrig remote MCP: what snifrig is and how to install it (stateless, localhost only)
After=network-online.target

[Service]
DynamicUser=yes
ExecStart=/usr/bin/python3 -I /opt/snifrig-mcp/server.py --port 8097
Restart=on-failure
RestartSec=5
MemoryMax=32M
CPUQuota=10%
TasksMax=8
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
